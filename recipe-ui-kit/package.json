{
  "name": "@mayank_singh28/recipe-ui-kit",
  "version": "1.0.0",
  "description": "Framework-agnostic web components for recipe discovery and meal planning UIs, built with StencilJS.",
  "license": "MIT",
  "author": "Mayank Singh",
  "keywords": [
    "stencil",
    "stenciljs",
    "web-components",
    "custom-elements",
    "design-system",
    "component-library",
    "recipe",
    "meal-planner",
    "svelte"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagarro-mayank28/recipe-finder-meal-planner.git",
    "directory": "recipe-ui-kit"
  },
  "homepage": "https://github.com/nagarro-mayank28/recipe-finder-meal-planner/tree/main/recipe-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/nagarro-mayank28/recipe-finder-meal-planner/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/recipe-ui-kit/recipe-ui-kit.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./tokens.css": "./dist/recipe-ui-kit/recipe-ui-kit.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  }
}
