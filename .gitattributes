# Normalise line endings so the repo stays clean across Windows / macOS / Linux
# and CI never sees a whole-file diff caused only by CRLF.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated lockfiles: keep them in the repo but out of diff review noise.
package-lock.json linguist-generated=true -diff
